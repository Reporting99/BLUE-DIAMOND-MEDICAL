# Blue Diamond Medical — environment variables
# Copy to .env.local for development. No real secrets in this file, ever.
# Every value below is currently UNSET in this build — see
# docs/MISSING_CONTENT_REPORT.md for what depends on each one.

# --- ImageKit (media CDN) ---------------------------------------------
# The approved account/endpoint (brief §12) is https://ik.imagekit.io/oq92dh6zib
# — src/config/imagekit.ts already defaults NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT
# to this value, so it's optional to set here (only needed to override it,
# e.g. pointing at a staging ImageKit account). Every image still renders
# the abstract "Facet Tile" placeholder until an asset's manifest entry
# (src/lib/media/image-manifest.ts) has status: "approved" — no real
# photography has been uploaded to this account yet. Public/private keys
# ARE real secrets and must be set for the SDK's authenticated upload flow;
# full setup procedure: docs/IMAGEKIT_SETUP.md.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/oq92dh6zib
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- FeelStack CMS ------------------------------------------------------
# Not yet provisioned for this build; adapter is production-ready
# (src/lib/feelstack/) but content stays local until these are set. See
# docs/DEPLOYMENT_GUIDE.md and docs/FEELSTACK_MIGRATION_MANIFEST.md.
FEELSTACK_API_URL=
FEELSTACK_SITE_KEY=blue-diamond-medical
FEELSTACK_REVALIDATE_SECRET=
# The FeelStack project UUID this deployment accepts webhook events for.
# REQUIRED whenever FEELSTACK_REVALIDATE_SECRET is set: the revalidate
# endpoint 501s without it rather than defaulting to a tenant, and rejects
# any event whose projectId does not match with 403 project_mismatch.
# Blue Diamond is d1a870a4-a514-4719-bf71-6cff26b18dcb.
FEELSTACK_PROJECT_ID=
# static (default, matches this build's current behavior) | hybrid (try
# FeelStack, fall back to src/content/*.ts only for entities not yet
# migrated — never for a CMS outage) | cms (FeelStack only, no fallback).
# Setting hybrid/cms without FEELSTACK_API_URL + FEELSTACK_SITE_KEY is a
# startup configuration error, not a silent no-op — src/lib/feelstack/content-mode.ts.
FEELSTACK_CONTENT_MODE=static

# Shared secret for the FeelStack draft-preview entry point
# (/api/draft). Unset = preview is disabled and the route 501s; it is never
# forwarded, echoed or logged — src/app/api/draft/route.ts. Server-side only:
# never expose it as a NEXT_PUBLIC_* variable.
FEELSTACK_PREVIEW_SECRET=

# --- FeelStack media import (scripts/import-before-after.mjs) ------------
# Credentials for the one-off media-import script only. Never read by the
# application at runtime and never required for a build — set them in your
# shell for the duration of an import run rather than committing them here.
FEELSTACK_ADMIN_PROJECT_ID=
FEELSTACK_ADMIN_USERNAME=
FEELSTACK_ADMIN_PASSWORD=
# Optional local directory holding the staged before/after originals. Leave
# unset to have the script read each asset from its recorded source.
BEFORE_AFTER_STAGE_DIR=

# --- Contact form delivery ----------------------------------------------
# Unset = the contact form validates and rate-limits submissions but shows
# a "please call us" fallback instead of a false success message — see
# src/lib/forms/contact-delivery.ts. Set to a supported provider id once
# credentials exist (no provider is implemented yet).
CONTACT_DELIVERY_PROVIDER=

# --- Site: the one authoritative public origin -----------------------------
#
# LEAVE BLANK UNTIL THE FINAL DOMAIN IS CONNECTED AND APPROVED.
#
# The single source of truth for every canonical tag, hreflang alternate,
# Open Graph URL, JSON-LD URL and sitemap entry in the app. Resolved in exactly
# one place, src/config/site-url.ts; nothing else in the codebase may name a
# domain. There is deliberately no default — this file must not carry a guessed
# or aspirational hostname, because a value here becomes the site's published
# identity the moment a build reads it.
#
# Rules the resolver enforces (anything failing them is treated as UNSET):
#   - absolute, scheme https:// (http is rejected)
#   - a real public hostname: no localhost, no bare IP, no single-label host,
#     no *.pages.dev / *.workers.dev / *.vercel.app / *.ngrok* / .local /
#     .internal and no explicit port
#   - origin only: no path, query or fragment, no trailing slash, no userinfo
#
# When it is UNSET the app does not fall back to anything. Pages emit NO
# canonical, NO hreflang and NO og:url rather than a fabricated or localhost
# one, robots.txt answers `Disallow: /`, and sitemap.xml is empty. That is the
# correct pre-domain state, not a degraded one.
#
# Read at BUILD time for page metadata (statically generated) and at REQUEST
# time for robots.txt / sitemap.xml / llms.txt, so it must be present in both
# environments. Not a secret — the public domain is public by definition.
#
# Example of the shape only, NOT this site's domain: https://example.ca
SITE_URL=

# Deprecated alias for SITE_URL, still honoured so existing slot env files and
# scripts/feelstack-republish.mjs keep working. SITE_URL wins when both are
# set. Prefer SITE_URL: this value has no reason to be exposed to the browser.
NEXT_PUBLIC_SITE_URL=

# --- Indexing gate ---------------------------------------------------------
#
# LEAVE UNSET UNTIL INDEXING IS EXPLICITLY AUTHORISED.
#
# Anything other than the exact string "true" means NOT indexable, so an unset,
# empty, typo'd or half-configured environment fails closed.
#
# Indexing requires BOTH this flag AND a valid SITE_URL above. A hostname
# existing is not consent to be indexed, and consent without a verified origin
# would publish canonical tags and a sitemap with nothing trustworthy in them.
# The two conditions are ANDed in isIndexingEnabled() (src/config/launch.ts).
#
# While either half is missing:
#
#   robots.txt      ->  User-Agent: *  /  Disallow: /   (and no Sitemap: line)
#   sitemap.xml     ->  empty
#   llms.txt        ->  404
#   every response  ->  X-Robots-Tag: noindex, nofollow, noarchive, ...
#   every page      ->  <meta name="robots" content="noindex, nofollow">
#                       and no canonical/hreflang/og:url at all
#
# `SITE_LAUNCHED` is the original name for this switch and is still accepted
# (INDEXING_ENABLED wins when both are set), because it is the name the
# deployment runbook and both slot env files use.
#
# Server-only: never give either name a NEXT_PUBLIC_ prefix, or a build could
# be made indexable from the browser side.
#
# In production this belongs in the per-slot runtime env files AND in the build
# environment — page <meta robots> is baked at build time, so flipping it on a
# running server is not sufficient. Full procedure:
# docs/DOMAIN_SEO_ACTIVATION.md, and docs/PRE_LAUNCH_INDEXING_GUARD.md.
# INDEXING_ENABLED=true
