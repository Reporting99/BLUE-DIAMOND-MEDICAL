# Blue Diamond Medical — environment variables
# Copy to .env.local for development. No real secrets in this file, ever.
# Every value below is currently UNSET in this build — see
# docs/MISSING_CONTENT_REPORT.md for what depends on each one.

# --- ImageKit (media CDN) ---------------------------------------------
# The approved account/endpoint (brief §12) is https://ik.imagekit.io/oq92dh6zib
# — src/config/imagekit.ts already defaults NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT
# to this value, so it's optional to set here (only needed to override it,
# e.g. pointing at a staging ImageKit account). Every image still renders
# the abstract "Facet Tile" placeholder until an asset's manifest entry
# (src/content/media/image-manifest.ts) has status: "approved" — no real
# photography has been uploaded to this account yet. Public/private keys
# ARE real secrets and must be set for the SDK's authenticated upload flow;
# full setup procedure: docs/IMAGEKIT_SETUP.md.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/oq92dh6zib
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- FeelStack CMS ------------------------------------------------------
# Not yet provisioned for this build; adapter is production-ready
# (src/lib/feelstack/) but content stays local until these are set. See
# docs/DEPLOYMENT_GUIDE.md and docs/FEELSTACK_MIGRATION_MANIFEST.md.
FEELSTACK_API_URL=
FEELSTACK_SITE_KEY=blue-diamond-medical
FEELSTACK_REVALIDATE_SECRET=
# The FeelStack project UUID this deployment accepts webhook events for.
# REQUIRED whenever FEELSTACK_REVALIDATE_SECRET is set: the revalidate
# endpoint 501s without it rather than defaulting to a tenant, and rejects
# any event whose projectId does not match with 403 project_mismatch.
# Blue Diamond is d1a870a4-a514-4719-bf71-6cff26b18dcb.
FEELSTACK_PROJECT_ID=
# static (default, matches this build's current behavior) | hybrid (try
# FeelStack, fall back to src/content/*.ts only for entities not yet
# migrated — never for a CMS outage) | cms (FeelStack only, no fallback).
# Setting hybrid/cms without FEELSTACK_API_URL + FEELSTACK_SITE_KEY is a
# startup configuration error, not a silent no-op — src/lib/feelstack/content-mode.ts.
FEELSTACK_CONTENT_MODE=static

# --- Contact form delivery ----------------------------------------------
# Unset = the contact form validates and rate-limits submissions but shows
# a "please call us" fallback instead of a false success message — see
# src/lib/forms/contact-delivery.ts. Set to a supported provider id once
# credentials exist (no provider is implemented yet).
CONTACT_DELIVERY_PROVIDER=

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://bluediamondmedical.ca

# --- Pre-launch indexing gate ---------------------------------------------
#
# LEAVE UNSET UNTIL LAUNCH IS AUTHORISED.
#
# Read at request time by robots.txt, sitemap.xml and src/proxy.ts. Anything
# other than the exact string "true" means NOT launched, so an unset, empty or
# typo'd value fails closed:
#
#   robots.txt      ->  User-Agent: *  /  Disallow: /   (and no Sitemap: line)
#   sitemap.xml     ->  empty
#   every response  ->  X-Robots-Tag: noindex, nofollow, noarchive, ...
#   every page      ->  <meta name="robots" content="noindex, nofollow">
#
# Canonical/hreflang/OG URLs are NOT affected -- they point at the real launch
# domain in both states, which is correct and must not churn at launch.
#
# In production this belongs in the per-slot runtime env files, and must be
# set on BOTH slots. See docs/PRE_LAUNCH_INDEXING_GUARD.md.
# SITE_LAUNCHED=true
