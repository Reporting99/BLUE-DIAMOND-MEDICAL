*.tsbuildinfo
next-env.d.ts

# testing
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Playwright MCP browser artifacts — generated console logs and accessibility
# snapshots from interactive browsing sessions. 40 of these were committed in
# d50a68d; they are build/session output, referenced by nothing in src, tests,
# CI or docs, and are removed in this change. docs/screenshots/ is NOT covered
# here: those are curated evidence images referenced by the docs.
/.playwright-mcp/
/traces/
/videos/
