# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Playwright MCP browser artifacts — generated console logs and accessibility
# snapshots from interactive browsing sessions. 40 of these were committed in
# d50a68d; they are build/session output, referenced by nothing in src, tests,
# CI or docs.
/.playwright-mcp/
/traces/
/videos/

# Screenshots are validation evidence, not source. Capture them while checking a
# change, read them, then let them go — a committed PNG is a claim about a build
# that no longer exists, and nothing in src, tests or CI reads one.
/screenshots/
/docs/screenshots/
*.png.tmp

# Generated by scripts/imagekit-import.mjs on each run. The script is the source
# of truth; its output is not.
/docs/imagekit-import-report.json

# No log or scratch file belongs in source. Anything a run produces is either
# reproducible or not worth keeping; a committed log is a claim about a build
# that no longer exists.
*.log
*.tmp
*.bak
*.old
*.orig
*.zip
*.tar
*.tar.gz
*.trace.zip
/dist/
/build/
/.cache/
/tmp/
/temp/
/logs/

# OS and editor droppings.
Thumbs.db
.idea/
.vscode/
*.swp

# One-off engineering verification harnesses and the JSON/PNG evidence they
# produce. Written per change-request ticket, read once, then superseded by the
# next build -- they are not part of the product and must not enter the source
# history. Permanent checks belong in tests/ and scripts/ instead.
/evidence/
/aesthetics-audit.mjs
/before-after-render-check.mjs
/booking-destination-check.mjs
/cl033-shots.mjs
/responsive-check.mjs
/route-health.mjs
/section-gaps.mjs
/stale-cms-probe.mjs

# Raw client media staged for an ImageKit import run. The originals live with
# the client and the delivered assets live in ImageKit; the staging folder is a
# local workspace, not source.
/_imagekit_import/
