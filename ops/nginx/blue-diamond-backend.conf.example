# /etc/nginx/snippets/blue-diamond-backend.conf
#
# DO NOT INSTALL YET.
#
# This file is the Blue/Green traffic switch: it holds exactly one line, and
# the deploy script rewrites it atomically (write to .new, rename, `nginx -t`,
# reload) to move traffic between slots. A rollback is the same one-line
# rewrite in the opposite direction, so it costs a reload rather than a
# rebuild.
#
# It is committed here, unlinked, because Blue Diamond has no public domain
# yet. Installing it -- and the vhost that includes it -- is part of the
# launch procedure, not of this integration phase. Until it exists, the deploy
# script detects its absence and skips the traffic switch, logging
# TRAFFIC_SWITCH_SKIPPED rather than pretending a switch happened.
#
# Initial content (blue serving):

proxy_pass http://127.0.0.1:3030/;
