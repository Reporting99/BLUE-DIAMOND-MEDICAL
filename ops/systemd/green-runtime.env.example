# /home/blue-diamond/shared/green-runtime.env  (mode 0640, root:blue-diamond)
#
# Per-slot runtime values ONLY. No application secrets: those live in
# /home/blue-diamond/shared/.env.production, which each release symlinks as
# .env, so there is exactly one copy of them on disk and a rollback cannot
# restore stale configuration along with old code.
#
# HOSTNAME pins the listener to loopback. The application must never bind a
# public interface -- Nginx is the only thing on this host that may face the
# internet, and on a shared multi-tenant box a 0.0.0.0 bind would expose the
# app to every other tenant as well.
PORT=3031
HOSTNAME=127.0.0.1
NODE_ENV=production

# PRE-LAUNCH INDEXING GATE -- see src/config/launch.ts and
# docs/PRE_LAUNCH_INDEXING_GUARD.md.
#
# Absent or anything other than the exact string "true" means NOT launched:
# robots.txt serves Disallow: /, the sitemap is empty, every response carries
# a noindex X-Robots-Tag, and every page emits noindex metadata.
#
# Leave this OUT until launch is authorised. Setting it is the single,
# auditable switch that makes the site indexable, and it must be set on BOTH
# slots so a Blue/Green switch cannot change indexability by accident.
# SITE_LAUNCHED=true
